# URL base da API consumida pelo frontend.
# Em desenvolvimento, o Vite encaminha /api para o backend (proxy), evitando CORS.
VITE_API_URL=/api

# Destino do proxy do Vite em desenvolvimento (backend Express + Prisma).
VITE_PROXY_TARGET=http://localhost:3000

# Chave da Google Maps Embed API usada no mapa do ensaio.
# Opcional: sem a chave o mapa cai no embed publico do Google Maps.
VITE_GOOGLE_MAPS_API_KEY=
