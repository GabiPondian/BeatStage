# Banco de dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/BeatStage?schema=public"

# Porta do servidor
PORT=3000

# Segredo usado para assinar os JWT (mínimo de 32 caracteres)
# Gere um valor único, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais"

# Validade do access token (formato aceito pela lib jsonwebtoken: 1h, 30m, 7d...)
JWT_EXPIRES_IN="1h"

# ==================== E-MAIL (RECUPERAÇÃO DE SENHA) ====================
# Envio por SMTP. Serve para Gmail (senha de app), Mailtrap, Brevo, Resend, etc.
# Sem SMTP_HOST o e-mail NÃO é enviado: o link de recuperação aparece no terminal.
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="usuario@exemplo.com"
SMTP_PASS="sua-senha-ou-chave-smtp"
SMTP_FROM="BeatStage <nao-responda@beatstage.com>"

# URL usada no link do e-mail de recuperação (frontend)
APP_URL="http://localhost:5173"
